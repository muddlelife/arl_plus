# ARL Docker 部署配置文件
# 复制为 .env 后根据需求修改

# ----- 管理员账号 -----
ARL_ADMIN_USERNAME=admin
ARL_ADMIN_PASSWORD=arlpass

# ----- Web 访问端口（宿主机端口）-----
# Web 服务对外暴露 HTTPS 端口，默认 5003
ARL_WEB_PORT=5003

# ----- Celery Worker 并发数 -----
# arltask: 主任务队列（域名扫描、端口扫描等）
# arlgithub: GitHub 监控队列
CELERY_ARLTASK_CONCURRENCY=2
CELERY_ARLGITHUB_CONCURRENCY=2

# ----- MongoDB 连接 -----
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=admin
MONGO_INITDB_DATABASE=arl

# ----- RabbitMQ 连接 -----
RABBITMQ_DEFAULT_USER=arl
RABBITMQ_DEFAULT_PASS=arlpassword
RABBITMQ_DEFAULT_VHOST=arlv2host

# ----- 构建版本号 -----
# 留空则使用 local
ARL_VERSION=local

# ----- GitHub Token（可选）-----
# 用于 GitHub 关键字监控功能，不填则功能不可用
GITHUB_TOKEN=
